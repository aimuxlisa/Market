# ==============================================================================
# Nexora Store — Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GIT.
# ==============================================================================

# Database
# For local development with SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL in staging/production:
# DATABASE_URL="postgresql://user:password@localhost:5432/nexora?schema=public"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Sessions
# Generate a secure random string (e.g. `openssl rand -base64 32`)
AUTH_SECRET="your-super-secret-random-key-change-this-in-production"

# Google OAuth (Optional — leave empty if not configured)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Payment Integration: Stripe (Test Mode — Stage 7)
ENABLE_STRIPE="true"
STRIPE_SECRET_KEY="sk_test_your_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_CURRENCY="uzs"

# Payment Integration: YooKassa (Alternative provider)
ENABLE_YOOKASSA="false"
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Admin seed token (used only for initial secure setup script)
ADMIN_SEED_SECRET="nexora-admin-setup-change-me"
